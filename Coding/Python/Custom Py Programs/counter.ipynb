   "source": [
    "def custom_counter(iterable):\n",
    "    freq={}\n",
    "    for item in iterable:\n",
    "        if item in freq:\n",
    "            freq[item]+=1\n",
    "        else:\n",
    "            freq[item]=1\n",
    "    return freq\n",
    "\n",
    "\n",
    "data = ['a', 'b', 'a', 'c', 'b', 'a']\n",
    "\n",
    "result = custom_counter(data)\n",
    "print(result)"
   ]
  }
 ],
